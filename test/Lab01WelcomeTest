/*
 * Automated test driver for Lab 01. DO NOT EDIT THIS FILE.
 * Run it with:  bash tools/run_lab.sh lab01
 */
public class Lab01WelcomeTest {

    public static void main(String[] args) {

        // Run the student's program with no keyboard input and capture everything it prints.
        String out = TestRunner.runMain(Lab01Welcome::main, "");

        TestRunner.section("Lab 01 - Welcome Banner");

        // The program must produce exactly six non-blank lines.
        TestRunner.checkLineCount("Program prints exactly 6 non-blank lines", out, 6);

        // Split the captured output so the first and last lines can be inspected individually.
        String[] lines = out.trim().split("\\R");
        String banner = "****************************************";

        TestRunner.checkTrue("First line is a 40-asterisk banner",
                lines.length > 0 && lines[0].trim().equals(banner));
        TestRunner.checkTrue("Last line is a 40-asterisk banner",
                lines.length > 1 && lines[lines.length - 1].trim().equals(banner));

        // Required text content.
        TestRunner.checkOutputContains("Course line present", out, "COSC 1173 Programming Lab");
        TestRunner.checkOutputContains("Student line present", out, "Student:");
        TestRunner.checkOutputContains("Welcome line present", out, "Welcome to");
        TestRunner.checkOutputContains("Average label present", out, "Average score:");

        // The escaped double-quote characters must actually appear in the output.
        TestRunner.checkTrue("Escaped double quotes appear around the book title",
                out.contains("\"Introduction to Java Programming\""));

        // The placeholder text must be gone.
        TestRunner.checkOutputLacks("No REPLACE ME placeholders remain", out, "REPLACE ME");

        // (88 + 92 + 79) / 3.0 = 86.3333...  Integer division by 3 would yield 86 and fail.
        TestRunner.checkOutputHasNumber("Average computed as 86.333... (floating point division)",
                out, 86.3333333, 0.01);

        TestRunner.exitWithSummary();
    }
}
